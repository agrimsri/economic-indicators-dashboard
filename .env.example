# Application Environment
APP_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL private connection)
DATABASE_URL=postgresql://app_user:password@127.0.0.1:5432/economic_dashboard

# Authentication
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# CORS & Cookies
CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Data Collector / Scheduler
ENABLE_SCHEDULER=true
NSE_BASE_URL=https://www.nseindia.com
NSE_POLL_SECONDS_OPEN=20
NSE_POLL_SECONDS_CLOSED=600
HTTP_TIMEOUT_CONNECT=10
HTTP_TIMEOUT_READ=20

# Optional Public Data Keys
DATA_GOV_IN_API_KEY=

# Frontend Environment (Vite build)
VITE_API_BASE_URL=http://localhost:8000

# Local Design Tooling (Never committed or deployed)
FIGMA_TOKEN=
